rules_version = '2';
// AU-23A crew roster — paste into Firebase console → Firestore Database → Rules → Publish.
//   crew/{CALLSIGN}  : weight in kg (public read — that is the point: crew see each other's weight)
//   pins/{CALLSIGN}  : SHA-256 of  "au23a|CALLSIGN|PIN"  — never readable by anyone
//   fleet/{A/C no.}  : the aircraft empty-weight records (weight lb, arm in, W.B. date, remark) — public read; written ONLY by an editor
//   ud/{CALLSIGN}/k/*: that callsign's saved data, encrypted with a key made from the PIN (public read, ciphertext only); written only with the PIN proof
//   config/roles    : {admins: ["CALLSIGN", ...], testpilots: ["CALLSIGN", ...]} — YOU create this document in the console (see docs/AIRCRAFT-LIST-SETUP.md); the app cannot write it.
//                       testpilots + admins may change the aircraft list; admins may also reset a PIN or delete a callsign (ops/adm-{CALLSIGN}). Everyone else is a squadron pilot (uses the app, changes only their own data).
//   ops/adm-{CALLSIGN}: written by an admin in the SAME commit as the delete it authorises (a = 'pin' → delete pins/{CALLSIGN}; a = 'all' → also crew/{CALLSIGN} and ud/{CALLSIGN}/k/*). Never readable.
// A weight can only be written in the SAME commit as its pin record, and only when that pin record is new (first claim of the callsign)
// or carries the same hash as the stored one. The nonce "n" ties the two writes together, so a crew write without a valid pin write is refused.
// This keeps people from overwriting each other by accident. It is NOT strong security (a 4-digit PIN can be guessed by repeated tries).
service cloud.firestore {
  match /databases/{database}/documents {
    function okCs(cs) { return cs.matches('^[A-Z0-9][A-Z0-9_-]{1,15}$'); }
    function roles() { return get(/databases/$(database)/documents/config/roles).data; }
    function isAdmin(cs) { return cs in roles().get('admins', []); }
    function canFleet(cs) { return cs in roles().get('admins', []) || cs in roles().get('testpilots', []); }
    // true only when ops/adm-{cs} was written in THIS commit (t == request.time) — an old one cannot be reused
    function opFresh(cs) { return getAfter(/databases/$(database)/documents/ops/$('adm-' + cs)).data.t == request.time; }
    function opKind(cs) { return getAfter(/databases/$(database)/documents/ops/$('adm-' + cs)).data.a; }

    match /pins/{cs} {
      allow read: if false;
      allow delete: if okCs(cs) && opFresh(cs) && !isAdmin(cs);
      allow create: if okCs(cs)
        && request.resource.data.keys().hasOnly(['h', 'n'])
        && request.resource.data.h is string && request.resource.data.h.matches('^[0-9a-f]{64}$')
        && request.resource.data.n is string && request.resource.data.n.size() <= 40;
      allow update: if okCs(cs)
        && request.resource.data.keys().hasOnly(['h', 'n'])
        && request.resource.data.h == resource.data.h
        && request.resource.data.n is string && request.resource.data.n.size() <= 40;
    }

    match /crew/{cs} {
      allow read: if true;
      allow delete: if okCs(cs) && opFresh(cs) && opKind(cs) == 'all';
      allow create, update: if okCs(cs)
        && request.resource.data.keys().hasOnly(['w', 't', 'n'])
        && request.resource.data.w is number && request.resource.data.w >= 30 && request.resource.data.w <= 200
        && request.resource.data.t == request.time
        && request.resource.data.n is string
        && request.resource.data.n == getAfter(/databases/$(database)/documents/pins/$(cs)).data.n;
    }
    // ---- shared aircraft empty-weight list ------------------------------------------------------------------
    match /config/{d} {
      allow read: if true;
      allow write: if false;
    }

    // ---- administrator actions: one document per target callsign, rewritten for every action. Only an admin can write it, proving the PIN in the same commit. ----
    match /ops/{id} {
      allow read: if false;
      allow delete: if false;
      allow create, update: if id.matches('^adm-[A-Z0-9][A-Z0-9_-]{1,15}$')
        && request.resource.data.keys().hasOnly(['by', 'n', 't', 'a'])
        && request.resource.data.by is string && okCs(request.resource.data.by)
        && isAdmin(request.resource.data.by)
        && id != 'adm-' + request.resource.data.by
        && request.resource.data.a in ['pin', 'all']
        && request.resource.data.t == request.time
        && request.resource.data.n is string && request.resource.data.n.size() <= 40
        && request.resource.data.n == getAfter(/databases/$(database)/documents/pins/$(request.resource.data.by)).data.n;
    }

    // A record is written in the same commit as a re-write of the editor's own pins/{callsign} document (same hash = the editor proved the PIN);
    // the nonce n ties them together. "Deleting" a record = writing x:true (the app hides it). 8 records per commit at most (2 rule reads each, limit 20).
    match /fleet/{no} {
      allow read: if true;
      allow delete: if false;
      allow create, update: if no.matches('^[A-Za-z0-9._-]{1,16}$')
        && request.resource.data.keys().hasOnly(['w', 'arm', 'm', 'date', 'remark', 'by', 't', 'n', 'o', 'x'])
        && request.resource.data.keys().hasAll(['w', 'arm', 'date', 'remark', 'by', 't', 'n', 'o'])
        && request.resource.data.w is number && request.resource.data.w > 0 && request.resource.data.w <= 20000
        && request.resource.data.arm is number && request.resource.data.arm > 0 && request.resource.data.arm <= 1000
        && (!('m' in request.resource.data) || (request.resource.data.m is number && request.resource.data.m > 0))
        && request.resource.data.date is string && request.resource.data.date.size() <= 8
        && request.resource.data.remark is string && request.resource.data.remark.size() <= 80
        && request.resource.data.o is number
        && (!('x' in request.resource.data) || request.resource.data.x is bool)
        && request.resource.data.t == request.time
        && request.resource.data.by is string
        && canFleet(request.resource.data.by)
        && request.resource.data.n == getAfter(/databases/$(database)/documents/pins/$(request.resource.data.by)).data.n;
    }

    // ---- each callsign's own saved data, synced across devices (encrypted in the browser with a key made from the PIN: the server only sees ciphertext) ----
    //   ud/{CALLSIGN}/k/_m           : the index, a JSON string {"key":[version,chunks]}
    //   ud/{CALLSIGN}/k/c-<key>-<i>  : chunk i of one saved item (base64 ciphertext, up to 600 000 characters)
    // Anyone can READ it (that is how another device gets it) but cannot decrypt without the PIN; writing needs the same pins re-write + nonce as above.
    // 8 writes per commit at most (1 rule read each + pins), so a commit is far below the limit of 20.
    match /ud/{cs}/k/{id} {
      allow read: if okCs(cs);
      allow delete: if okCs(cs) && opFresh(cs) && opKind(cs) == 'all';
      allow create, update: if okCs(cs)
        && request.resource.data.t == request.time
        && request.resource.data.n is string && request.resource.data.n.size() <= 40
        && request.resource.data.n == getAfter(/databases/$(database)/documents/pins/$(cs)).data.n
        && ((id == '_m'
              && request.resource.data.keys().hasOnly(['m', 't', 'n'])
              && request.resource.data.m is string && request.resource.data.m.size() <= 20000)
            || (id.matches('^c-[A-Za-z0-9._-]{1,72}-[0-5]$')
              && request.resource.data.keys().hasOnly(['c', 'v', 't', 'n'])
              && request.resource.data.c is string && request.resource.data.c.size() <= 650000
              && request.resource.data.v is number));
    }
  }
}
